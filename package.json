{
  "name": "obsidian-plugins-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "AI Manuscript Studio Obsidian plugin monorepo.",
  "scripts": {
    "test": "pnpm run test:deploy-contract && pnpm -r test",
    "test:deploy-contract": "node tests/deploy-contract.mjs",
    "build": "pnpm -r build",
    "build:plugins": "pnpm --filter @ai-manuscript-studio/core build && pnpm --filter @ai-manuscript-studio/obsidian-plugin build",
    "deploy": "bash scripts/deploy-obsidian-plugins.sh",
    "plugins:deploy": "bash scripts/deploy-obsidian-plugins.sh",
    "deploy:ai-manuscript": "bash scripts/deploy-obsidian-plugins.sh ai-manuscript-studio",
    "typecheck": "pnpm -r exec tsc -noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
